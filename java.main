import java.util.Scanner;

public class StudentManagement {

    public static void main(String[] args) {

        Scanner sc = new Scanner(System.in);

        String name;
        int age;
        int marks;
        int choice;

        System.out.println("===== Student Management System =====");

        System.out.print("Enter Student Name: ");
        name = sc.nextLine();

        System.out.print("Enter Age: ");
        age = sc.nextInt();

        System.out.print("Enter Marks: ");
        marks = sc.nextInt();

        // Age check
        if (age >= 18) {
            System.out.println("You are eligible for college.");
        } else {
            System.out.println("You are not eligible for college.");
        }

        // Marks grading
        if (marks >= 90) {
            System.out.println("Grade: A+");
        } else if (marks >= 75) {
            System.out.println("Grade: A");
        } else if (marks >= 60) {
            System.out.println("Grade: B");
        } else if (marks >= 50) {
            System.out.println("Grade: C");
        } else {
            System.out.println("Grade: Fail");
        }

        // Menu-driven system
        do {
            System.out.println("\n===== MENU =====");
            System.out.println("1. Display Student Info");
            System.out.println("2. Check Pass/Fail");
            System.out.println("3. Show Remarks");
            System.out.println("4. Exit");

            System.out.print("Enter your choice: ");
            choice = sc.nextInt();

            if (choice == 1) {
                System.out.println("\n--- Student Info ---");
                System.out.println("Name: " + name);
                System.out.println("Age: " + age);
                System.out.println("Marks: " + marks);
            } 
            else if (choice == 2) {
                if (marks >= 50) {
                    System.out.println("Result: PASS ✅");
                } else {
                    System.out.println("Result: FAIL ❌");
                }
            } 
            else if (choice == 3) {
                if (marks >= 90) {
                    System.out.println("Excellent performance!");
                } else if (marks >= 70) {
                    System.out.println("Good job!");
                } else if (marks >= 50) {
                    System.out.println("You can improve.");
                } else {
                    System.out.println("Work harder next time.");
                }
            } 
            else if (choice == 4) {
                System.out.println("Exiting program...");
            } 
            else {
                System.out.println("Invalid choice!");
            }

        } while (choice != 4);

        sc.close();
    }
}